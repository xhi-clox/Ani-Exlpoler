# Environment variables used by Analithe.
#
# Copy to `.env` for local development. Values in this file are examples only;
# never commit real secrets.

# --- API server (artifacts/api-server) -------------------------------------
# Postgres connection string. Migrations run automatically on boot.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/analithe
# Strong random string used to sign auth JWTs.
JWT_SECRET=change-me-to-a-long-random-string
# Port the API listens on locally.
PORT=8080
# Optional: "auto" (default), "jikan", or "anilist".
ANIME_PROVIDER=auto
# Optional: "info", "debug", ...
LOG_LEVEL=info

# --- Frontend (artifacts/anime-stream) -------------------------------------
# Base URL of the API including the `/api` suffix. Leave unset in development
# to use the Vite proxy at `/api`.
# VITE_API_SERVER_URL=https://your-api.onrender.com/api
